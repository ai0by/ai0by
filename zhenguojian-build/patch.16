+          child: const Text('取消'),
+        ),
+        TextButton(
+          onPressed: () => Navigator.pop(context, ''),
+          child: const Text('清空'),
+        ),
+        FilledButton(
+          onPressed: _submit,
+          child: const Text('搜索'),
+        ),
+      ],
+    );
+  }
 }
