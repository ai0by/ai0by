+      height: 118,
+      padding: const EdgeInsets.symmetric(horizontal: 22),
+      decoration: BoxDecoration(
+        borderRadius: BorderRadius.circular(14),
+        color: accent,
+      ),
+      child: Row(
+        children: [
+          Icon(icon, size: iconSize, color: iconColor),
+          const SizedBox(width: 16),
+          Expanded(
+            child: Column(
+              mainAxisAlignment: MainAxisAlignment.center,
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                Text(
+                  title,
+                  maxLines: 1,
+                  overflow: TextOverflow.ellipsis,
+                  style: TextStyle(
+                    fontSize: titleSize,
+                    fontWeight: FontWeight.w800,
+                    color: Colors.white,
+                  ),
+                ),
+                const SizedBox(height: 6),
+                Text(
+                  subtitle,
+                  maxLines: 1,
+                  overflow: TextOverflow.ellipsis,
+                  style: TextStyle(
+                    fontSize: 14,
+                    color: Colors.white.withValues(alpha: .62),
+                  ),
+                ),
+              ],
+            ),
+          ),
+        ],
+      ),
+    ),
+  );
+
+  /// 搜索结果页（0.8.4）。
+  ///
+  /// 用 `Wrap` 而不是单行横向列表：遥控器在 `Wrap` 里上下左右都能按几何位置
+  /// 找邻居，而横向 `ListView` 只有左右可用，搜出几十部时得一路按到头。
+  Widget _searchResults() {
+    final items = widget.items.take(40).toList();
+    final subtitle = items.isEmpty
+        ? '换个关键词再试，或按「返回」回到首页'
+        : '支持子序列：hjdnz / hdz / hnz 都能搜到「黄金大逆转」';
+    return ListView(
+      padding: const EdgeInsets.fromLTRB(24, 20, 24, 32),
+      children: [
+        Row(
+          children: [
+            Expanded(
+              child: Text(
+                items.isEmpty
+                    ? '「${widget.searchQuery}」没有找到匹配的短剧'
+                    : '「${widget.searchQuery}」· 找到 ${items.length} 部',
+                maxLines: 1,
+                overflow: TextOverflow.ellipsis,
+                style: const TextStyle(
+                  fontSize: 22,
+                  fontWeight: FontWeight.w800,
+                  color: Colors.white,
+                ),
+              ),
+            ),
+            if (widget.onClearSearch != null)
+              RemoteTarget(
+                key: const ValueKey('tv-search-clear'),
+                // 一部都没搜到时焦点直接落在这里，用户按确定就能退出搜索态，
+                // 不会卡在一个空页面上找不到出口。
+                autofocus: items.isEmpty,
+                onPressed: widget.onClearSearch!,
+                label: '清除搜索，返回电视首页',
+                child: Container(
+                  padding: const EdgeInsets.symmetric(
+                    horizontal: 18,
+                    vertical: 11,
+                  ),
+                  decoration: BoxDecoration(
+                    color: const Color(0xFF1C1D22),
+                    borderRadius: BorderRadius.circular(10),
+                  ),
+                  child: const Row(
+                    mainAxisSize: MainAxisSize.min,
+                    children: [
+                      Icon(Icons.close_rounded, size: 18, color: Colors.white),
+                      SizedBox(width: 6),
+                      Text(
+                        '清除搜索',
+                        style: TextStyle(fontSize: 15, color: Colors.white),
+                      ),
+                    ],
+                  ),
+                ),
+              ),
+          ],
+        ),
+        const SizedBox(height: 8),
+        Text(
+          subtitle,
+          style: TextStyle(
+            fontSize: 14,
+            color: Colors.white.withValues(alpha: .6),
+          ),
+        ),
+        const SizedBox(height: 20),
+        if (items.isNotEmpty)
+          Wrap(
+            spacing: 14,
+            runSpacing: 18,
+            children: [
+              for (var index = 0; index < items.length; index++)
+                _poster(
+                  key: ValueKey(
+                    'tv-search-${items[index].source}-${items[index].id}',
+                  ),
+                  drama: items[index],
+                  autofocus: index == 0,
+                  subtitle: items[index].episodes > 0
+                      ? '共 ${items[index].episodes} 集'
+                      : null,
+                  onPressed: () => widget.onOpen(items[index]),
+                ),
+            ],
+          ),
+      ],
+    );
+  }
+
+  Widget _historyRow() {
+    final entries = widget.history.take(20).toList();
+    return _section(
+      title: '继续观看',
+      child: SizedBox(
+        height: _posterRowHeight,
+        child: ListView.separated(
+          scrollDirection: Axis.horizontal,
+          itemCount: entries.length,
+          separatorBuilder: (_, _) => const SizedBox(width: 14),
+          itemBuilder: (_, index) {
+            final entry = entries[index];
+            final percent = entry.duration <= 0
+                ? 0.0
+                : (entry.position / entry.duration).clamp(0.0, 1.0);
+            return _poster(
+              key: ValueKey('tv-continue-${entry.drama.id}'),
+              drama: entry.drama,
+              subtitle: entry.finished
+                  ? '已看完 · 第 ${entry.episode} 集'
+                  : '第 ${entry.episode} 集 · ${(percent * 100).round()}%',
+              progress: percent,
+              onPressed: () => widget.onResume(entry),
+            );
+          },
+        ),
+      ),
+    );
+  }
+
+  Widget _posterRow({
+    required String title,
+    required List<Drama> items,
+    VoidCallback? onMore,
+  }) => _section(
+    title: title,
+    onMore: onMore,
+    child: SizedBox(
+      height: _posterRowHeight,
+      child: ListView.separated(
+        scrollDirection: Axis.horizontal,
+        itemCount: items.length,
+        separatorBuilder: (_, _) => const SizedBox(width: 14),
+        itemBuilder: (_, index) {
+          final drama = items[index];
+          return _poster(
+            key: ValueKey('tv-poster-${drama.source}-${drama.id}'),
+            drama: drama,
+            subtitle: drama.episodes > 0 ? '共 ${drama.episodes} 集' : null,
+            onPressed: () => widget.onOpen(drama),
+          );
+        },
+      ),
+    ),
+  );
+
+  /// 按剧类分组，最多 4 行，每行最多 20 部。
+  List<Widget> _categoryRows() {
+    final groups = <String, List<Drama>>{};
+    for (final drama in widget.items) {
+      final name = categoryName(drama.category);
+      if (name.isEmpty) continue;
+      groups.putIfAbsent(name, () => []).add(drama);
+    }
+    final ordered = groups.entries.toList()
+      ..sort((a, b) => b.value.length.compareTo(a.value.length));
+    return [
+      for (final group in ordered.take(4))
+        if (group.value.length >= 4)
+          _posterRow(
+            title: group.key,
+            items: group.value.take(20).toList(),
+          ),
+    ];
+  }
+
+  Widget _section({
+    required String title,
+    required Widget child,
+    VoidCallback? onMore,
+  }) => Column(
+    crossAxisAlignment: CrossAxisAlignment.start,
+    children: [
+      Row(
+        children: [
+          Expanded(
+            child: Text(
+              title,
+              maxLines: 1,
+              overflow: TextOverflow.ellipsis,
+              style: const TextStyle(
+                fontSize: 22,
+                fontWeight: FontWeight.w800,
+                color: Colors.white,
+              ),
+            ),
+          ),
+          if (onMore != null)
+            RemoteTarget(
+              onPressed: onMore,
+              label: '$title，查看全部',
+              child: const Padding(
+                padding: EdgeInsets.symmetric(horizontal: 12, vertical: 8),
+                child: Text(
+                  '查看全部',
+                  style: TextStyle(fontSize: 15, color: Colors.white70),
+                ),
+              ),
+            ),
+        ],
+      ),
+      const SizedBox(height: 12),
+      child,
+    ],
+  );
+
+  static const double _posterRowHeight = 248;
+
+  Widget _poster({
+    required Key key,
+    required Drama drama,
+    required VoidCallback onPressed,
+    String? subtitle,
+    double? progress,
+    bool autofocus = false,
+  }) => SizedBox(
+    key: key,
+    width: 158,
+    height: _posterRowHeight,
+    child: RemoteTarget(
+      autofocus: autofocus,
+      onPressed: onPressed,
+      label: subtitle == null ? drama.title : '${drama.title}，$subtitle',
+      child: Column(
+        crossAxisAlignment: CrossAxisAlignment.stretch,
+        children: [
+          Expanded(
+            child: Stack(
+              fit: StackFit.expand,
+              children: [
+                DramaCover(drama: drama, repository: widget.repository),
+                if (progress != null)
+                  Positioned(
+                    left: 0,
+                    right: 0,
+                    bottom: 0,
+                    child: LinearProgressIndicator(
+                      value: progress,
+                      minHeight: 4,
+                      backgroundColor: Colors.black45,
+                      color: const Color(0xFFFF765F),
+                    ),
+                  ),
+              ],
+            ),
+          ),
+          const SizedBox(height: 6),
+          Text(
+            drama.title,
+            maxLines: 1,
+            overflow: TextOverflow.ellipsis,
+            style: const TextStyle(
+              fontSize: 15,
+              fontWeight: FontWeight.w600,
+              color: Colors.white,
+            ),
+          ),
+          if (subtitle != null)
+            Text(
+              subtitle,
+              maxLines: 1,
+              overflow: TextOverflow.ellipsis,
+              style: TextStyle(
+                fontSize: 13,
+                color: Colors.white.withValues(alpha: .55),
+              ),
+            ),
+        ],
+      ),
+    ),
+  );
+}
diff --git a/lib/tv_keyboard.dart b/lib/tv_keyboard.dart
new file mode 100644
index 0000000..03d6d9b
--- /dev/null
+++ b/lib/tv_keyboard.dart
@@ -0,0 +1,185 @@
+import 'package:flutter/material.dart';
+
+import 'remote_widgets.dart';
+
+/// 电视端屏幕键盘（0.8.3）。
+///
+/// 为什么需要它：电视搜索原先直接 `autofocus` 一个 [TextField]，
+/// 靠系统输入法打字。但相当一部分盒子（尤其运营商定制机、投影仪、
+/// 模拟器）**根本没有安装输入法**——焦点落进输入框之后，
+/// 遥控器方向键出不来、确定键没反应，整个搜索功能直接死在那里。
+///
+/// 这个键盘只用遥控器就能完成输入：
+/// - 方向键在字母之间移动，确定键输入一个字符；
+/// - ⌫ 删一个字符，清空 / 搜索在最后一行；
+/// - 系统输入法可用的设备仍然可以点输入框用 IME 打字，两条路并存。
+///
+/// 键位排布按 QWERTY，不按拼音——没有词库做不了拼音转汉字，
+/// 而站源搜索本身就是按剧名子串匹配，输入汉字才有意义。
+class TvSearchKeyboard extends StatelessWidget {
+  const TvSearchKeyboard({
+    super.key,
+    required this.onCharacter,
+    required this.onBackspace,
+    required this.onClear,
+    required this.onSubmit,
+  });
+
+  /// 输入一个字符（小写字母 / 数字）。
+  final ValueChanged<String> onCharacter;
+
+  /// 删除最后一个字符。
+  final VoidCallback onBackspace;
+
+  /// 清空全部输入。
+  final VoidCallback onClear;
+
+  /// 提交搜索。
+  final VoidCallback onSubmit;
+
+  static const _rows = <String>['qwertyuiop', 'asdfghjkl', 'zxcvbnm'];
+  static const _digits = '1234567890';
+
+  /// 单个按键尺寸。10 键一行 × 52 + 间隙 ≈ 580，正好放进 760 宽的对话框。
+  static const double _keyWidth = 52;
+  static const double _keyHeight = 50;
+
+  @override
+  Widget build(BuildContext context) {
+    // 整个键盘只在首帧抢一次焦点，后续重建（每输入一个字符都会重建）
+    // 不再重复请求，否则会把用户已经移动过去的焦点拉回第一个键。
+    var autofocusPending = true;
+
+    Widget key(
+      String label,
+      VoidCallback onPressed, {
+      String? id,
+      double width = _keyWidth,
+      IconData? icon,
+      bool primary = false,
+    }) {
+      final autofocus = autofocusPending;
+      autofocusPending = false;
+      return RemoteTarget(
+        key: ValueKey('tv-key-${id ?? label}'),
+        autofocus: autofocus,
+        onPressed: onPressed,
+        label: label,
+        child: _KeyCap(
+          label: label,
+          icon: icon,
+          width: width,
+          height: _keyHeight,
+          primary: primary,
+        ),
+      );
+    }
+
+    Widget row(List<Widget> keys) => Row(
+      mainAxisAlignment: MainAxisAlignment.center,
+      children: [
+        for (final child in keys)
+          Padding(padding: const EdgeInsets.all(3), child: child),
+      ],
+    );
+
+    return Column(
+      mainAxisSize: MainAxisSize.min,
+      children: [
+        for (final line in _rows)
+          row([
+            for (final char in line.split(''))
+              key(char, () => onCharacter(char), id: char),
+            if (line == _rows.last)
+              key(
+                '删除',
+                onBackspace,
+                id: 'backspace',
+                width: _keyWidth * 1.6,
+                icon: Icons.backspace_outlined,
+              ),
+          ]),
+        row([
+          for (final char in _digits.split(''))
+            key(char, () => onCharacter(char), id: char),
+        ]),
+        row([
+          key('清空', onClear, id: 'clear', width: _keyWidth * 2.4),
+          key(
+            '搜索',
+            onSubmit,
+            id: 'submit',
+            width: _keyWidth * 2.4,
+            icon: Icons.search_rounded,
+            primary: true,
+          ),
+        ]),
+      ],
+    );
+  }
+}
+
+/// 键盘上的一个键帽。
+class _KeyCap extends StatelessWidget {
+  const _KeyCap({
+    required this.label,
+    required this.width,
+    required this.height,
+    this.icon,
+    this.primary = false,
+  });
+
+  final String label;
+  final double width;
+  final double height;
+  final IconData? icon;
+  final bool primary;
+
+  @override
+  Widget build(BuildContext context) {
+    final colors = Theme.of(context).colorScheme;
+    return Container(
+      width: width,
+      height: height,
+      alignment: Alignment.center,
+      decoration: BoxDecoration(
+        color: primary
+            ? colors.primary.withValues(alpha: .16)
+            : colors.surfaceContainerHighest,
