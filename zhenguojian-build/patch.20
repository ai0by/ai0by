diff --git a/lib/tv_dialogs.dart b/lib/tv_dialogs.dart
new file mode 100644
index 0000000..56c1e3a
--- /dev/null
+++ b/lib/tv_dialogs.dart
@@ -0,0 +1,68 @@
+import 'package:flutter/material.dart';
+
+import 'app_layout.dart';
+import 'remote_widgets.dart';
+
+/// 电视友好的确认框（0.8.1）。
+///
+/// 为什么不直接用 `AlertDialog` + `TextButton`：
+/// - 电视上没有触摸，`TextButton` 虽然能获得焦点，但焦点环在深色对话框上
+///   不够醒目，10 英尺外看不清"当前选的是哪个"；
+/// - 这里两个按钮都用 [RemoteButton]（带缩放 + 描边 + 光晕的焦点样式），
+///   方向键左右移动、确定键触发，与全局遥控导航一致。
+///
+/// 默认焦点落在**取消**上：电视遥控容易连按，误按确定不该直接退出播放/退出应用。
+/// 返回键等价于取消（`showDialog` 的 barrier 被 DismissIntent 关闭，返回 null）。
+///
+/// 非电视模式同样可用，只是按钮变成了可点击的遥控按钮，视觉与全局一致。
+Future<bool> showTvConfirmDialog(
+  BuildContext context, {
+  required String title,
+  String? message,
+  String confirmLabel = '确定',
+  String cancelLabel = '取消',
+}) async {
+  final television = AppLayout.isTelevision(context);
+  final result = await showDialog<bool>(
+    context: context,
+    builder: (dialogContext) => AlertDialog(
+      insetPadding: EdgeInsets.symmetric(
+        horizontal: television ? 72 : 40,
+        vertical: 24,
+      ),
+      title: Text(
+        title,
+        style: TextStyle(
+          fontSize: television ? 22 : 18,
+          fontWeight: FontWeight.w600,
+        ),
+      ),
+      content: message == null
+          ? null
+          : ConstrainedBox(
+              constraints: const BoxConstraints(maxWidth: 460),
+              child: Text(
+                message,
+                style: TextStyle(
+                  fontSize: television ? 16 : 14,
+                  height: 1.6,
+                  color: Theme.of(dialogContext).colorScheme.onSurfaceVariant,
+                ),
+              ),
+            ),
+      actionsPadding: EdgeInsets.fromLTRB(16, 4, 16, television ? 16 : 8),
+      actions: [
+        RemoteButton(
+          label: cancelLabel,
+          autofocus: true,
+          onPressed: () => Navigator.pop(dialogContext, false),
+        ),
+        RemoteButton(
+          label: confirmLabel,
+          onPressed: () => Navigator.pop(dialogContext, true),
+        ),
+      ],
+    ),
+  );
+  return result ?? false;
+}
diff --git a/lib/tv_home.dart b/lib/tv_home.dart
new file mode 100644
index 0000000..4c247be
--- /dev/null
+++ b/lib/tv_home.dart
@@ -0,0 +1,558 @@
+import 'package:flutter/material.dart';
+
+import 'catalog_browser.dart';
+import 'core_bridge.dart';
+import 'models.dart';
+import 'remote_widgets.dart';
+import 'widgets.dart';
+
+/// 电视首页（0.8.3）。
+///
+/// 为什么要单独做一版：
+///
+/// 竖滑短视频流是**手机**的交互——上下滑换剧，靠的是手指。
+/// 搬到电视上之后，遥控器上下键只能"下一部/上一部"，
+/// 用户永远不知道剧库里还有什么，也回不到刚才看过的那部，
+/// 而且一进应用就开始播（电视上很吵、很吓人）。
+///
+/// 电视的浏览习惯是**横向海报行**：一行一个主题，左右移动挑片，
+/// 上下切主题。所以这里给电视单独一页：
+///
+/// 1. 「开始刷剧」——保留原来的竖滑流，作为"我就想随便看"的入口；
+/// 2. 「继续观看」——按观看记录排序，一键续播；
+/// 3. 「热门短剧」——当前站源剧库；
+/// 4. 分类行——按剧类分组，最多 4 行。
+///
+/// 竖滑流本身没有删掉，只是从"首页"变成了"刷剧模式"（[onStartFeed]）。
+class TvHomeScreen extends StatefulWidget {
+  const TvHomeScreen({
+    super.key,
+    required this.repository,
+    required this.items,
+    required this.history,
+    required this.loading,
+    required this.onOpen,
+    required this.onResume,
+    required this.onStartFeed,
+    required this.onBrowse,
+    required this.onSearch,
+    required this.onRefresh,
+    this.searchQuery = '',
+    this.onClearSearch,
+    this.emptyMessage,
+    this.onContentReady,
+  });
+
+  final AppRepository repository;
+
+  /// 当前站源剧库（已按站源权限过滤）。
+  final List<Drama> items;
+
+  /// 观看记录（已按时间倒序）。
+  final List<WatchEntry> history;
+
+  /// 是否正在加载第一批数据。
+  final bool loading;
+
+  /// 无站源 / 加载失败时的提示。
+  final String? emptyMessage;
+
+  final void Function(Drama drama) onOpen;
+  final void Function(WatchEntry entry) onResume;
+
+  /// 进入竖滑"刷剧"模式。
+  final VoidCallback onStartFeed;
+
+  /// 切到「发现」页浏览全部。
+  final VoidCallback onBrowse;
+
+  /// 打开搜索（0.8.4）：电视上搜索是主入口之一，不该先按左导航进「发现」。
+  final VoidCallback onSearch;
+
+  final VoidCallback onRefresh;
+
+  /// 当前生效的拼音/首字母关键词（0.8.4），空串表示不在搜索态。
+  ///
+  /// 非空时首页整页切换成"搜索结果"，不再显示海报行和分类行——
+  /// 否则搜索结果会混在「热门短剧」里，电视用户根本判断不出搜到没有。
+  final String searchQuery;
+
+  /// 清除搜索、回到常规首页。
+  final VoidCallback? onClearSearch;
+
+  /// 首批内容渲染完成（用于收起开屏页）。
+  final VoidCallback? onContentReady;
+
+  @override
+  State<TvHomeScreen> createState() => _TvHomeScreenState();
+}
+
+class _TvHomeScreenState extends State<TvHomeScreen> {
+  bool _reportedReady = false;
+
+  @override
+  void initState() {
+    super.initState();
+    _reportIfReady();
+  }
+
+  @override
+  void didUpdateWidget(covariant TvHomeScreen oldWidget) {
+    super.didUpdateWidget(oldWidget);
+    _reportIfReady();
+  }
+
+  /// 有内容可看时通知外层收起开屏页。
+  ///
+  /// 手机上这个信号来自竖滑流的 `onReady`；电视首页不再实例化竖滑流，
+  /// 不补这一下开屏页就只能等 3 秒超时。
+  ///
+  /// 必须推迟到帧后：`initState` / `didUpdateWidget` 都发生在 build 阶段，
+  /// 此时回调会直接改外层的 `ValueNotifier` → 开屏页 `setState`
+  /// → 触发 "setState() or markNeedsBuild() called during build"。
+  void _reportIfReady() {
+    if (_reportedReady || widget.loading) return;
+    if (widget.items.isEmpty && widget.history.isEmpty) return;
+    _reportedReady = true;
+    WidgetsBinding.instance.addPostFrameCallback((_) {
+      if (mounted) widget.onContentReady?.call();
+    });
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    if (widget.searchQuery.isNotEmpty) return _searchResults();
+    if (widget.items.isEmpty && widget.history.isEmpty) {
+      return _placeholder();
+    }
+    final rows = <Widget>[
+      _hero(),
+      if (widget.history.isNotEmpty) _historyRow(),
+      if (widget.items.isNotEmpty)
+        _posterRow(
+          title: '热门短剧',
+          items: widget.items.take(20).toList(),
+          onMore: widget.onBrowse,
+        ),
+      ..._categoryRows(),
+    ];
+    return ListView.separated(
+      padding: const EdgeInsets.fromLTRB(24, 20, 24, 32),
+      itemCount: rows.length,
+      separatorBuilder: (_, _) => const SizedBox(height: 26),
+      itemBuilder: (_, index) => rows[index],
+    );
+  }
+
+  Widget _placeholder() => Center(
+    child: Column(
+      mainAxisSize: MainAxisSize.min,
+      children: [
+        if (widget.loading)
+          const CircularProgressIndicator(strokeWidth: 3)
+        else ...[
+          const Icon(Icons.live_tv_outlined, size: 56, color: Colors.white54),
+          const SizedBox(height: 16),
+          Text(
+            widget.emptyMessage ?? '还没有可播放的内容',
+            style: const TextStyle(fontSize: 18, color: Colors.white70),
+            textAlign: TextAlign.center,
+          ),
+          const SizedBox(height: 20),
+          RemoteButton(
+            label: '重新加载',
+            icon: Icons.refresh_rounded,
+            autofocus: true,
+            onPressed: widget.onRefresh,
+          ),
+        ],
+      ],
+    ),
+  );
+
+  /// 顶部大卡：开始刷剧 / 搜索 / 浏览全部。
+  Widget _hero() => Row(
+    children: [
+      Expanded(
+        flex: 3,
+        child: _heroCard(
+          key: const ValueKey('tv-home-start-feed'),
+          autofocus: true,
+          onPressed: widget.onStartFeed,
+          label: '开始刷剧，进入竖滑短视频流',
+          icon: Icons.play_circle_fill_rounded,
+          iconColor: const Color(0xFFFF765F),
+          iconSize: 52,
+          title: '开始刷剧',
+          subtitle: '上下键换剧，左右键快进，按住确定键 3 倍速',
+          accent: const Color(0xFF3A1F1A),
+          titleSize: 26,
+        ),
+      ),
+      const SizedBox(width: 16),
+      Expanded(
+        flex: 2,
+        child: _heroCard(
+          key: const ValueKey('tv-home-search'),
+          onPressed: widget.onSearch,
+          label: '搜索短剧，支持拼音/首字母',
+          icon: Icons.search_rounded,
+          iconSize: 40,
+          title: '搜索',
+          subtitle: '剧名或拼音/首字母',
+          titleSize: 22,
+        ),
+      ),
+      const SizedBox(width: 16),
+      Expanded(
+        flex: 2,
+        child: _heroCard(
+          key: const ValueKey('tv-home-browse'),
+          onPressed: widget.onBrowse,
+          label: '浏览全部短剧',
+          icon: Icons.grid_view_rounded,
+          iconSize: 40,
+          title: '浏览全部',
+          subtitle: '按分类、榜单挑片',
+          titleSize: 22,
+        ),
+      ),
+    ],
+  );
+
+  /// 首页顶部的一张卡（0.8.4 抽出：三张卡共用同一套尺寸与配色）。
+  Widget _heroCard({
+    required Key key,
+    required VoidCallback onPressed,
+    required String label,
+    required IconData icon,
+    required String title,
+    required String subtitle,
+    required double titleSize,
+    double iconSize = 44,
+    Color? iconColor,
+    Color accent = const Color(0xFF1C1D22),
+    bool autofocus = false,
+  }) => RemoteTarget(
+    key: key,
+    autofocus: autofocus,
+    onPressed: onPressed,
+    label: label,
+    child: Container(
