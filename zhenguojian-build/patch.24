+    if (key == LogicalKeyboardKey.arrowLeft) {
+      // 长按连续快退：首次 -10 秒，按住后每帧 -5 秒（0.8.1）。
+      remote.seekBy(event is KeyRepeatEvent ? -5 : -10);
