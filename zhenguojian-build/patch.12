diff --git a/lib/remote_widgets.dart b/lib/remote_widgets.dart
index b33e22a..5f7b667 100644
--- a/lib/remote_widgets.dart
+++ b/lib/remote_widgets.dart
@@ -1,8 +1,124 @@
 import 'package:flutter/material.dart';
 
+import 'app_layout.dart';
 import 'search_input.dart';
+import 'tv_keyboard.dart';
 import 'package:flutter/services.dart';
 
+/// 「切换站源」胶囊入口（0.8.2）。
+///
+/// 首页 AppBar 和榜单页 AppBar 原本都是"裸文字 + 下箭头"，问题一致：
+/// - 看不出可点（和标题长得一模一样）；
+/// - 电视上 `InkWell` 不参与焦点遍历，遥控器**停不到这里**，等于没有入口。
+///
+/// 统一成胶囊后：图标 + 名称 + 站源数量 + 箭头，电视下再套 [RemoteTarget]
+/// 拿到焦点环 / 放大 / 外发光。
+class SourceSwitchPill extends StatelessWidget {
+  const SourceSwitchPill({
+    super.key,
+    required this.label,
+    required this.onPressed,
+    this.count = 1,
+    this.icon,
+    this.television,
+  });
+
+  final String label;
+
+  /// 该分组下的站源数量；>1 时显示数量徽标。
+  final int count;
+  final VoidCallback? onPressed;
+  final IconData? icon;
+
+  /// 覆盖电视判定（测试用）；为空时读 [AppLayout]。
+  final bool? television;
+
+  @override
+  Widget build(BuildContext context) {
+    final tv = television ?? AppLayout.isTelevision(context);
+    final colors = Theme.of(context).colorScheme;
+    final enabled = onPressed != null;
+    final pill = Container(
+      // 用 minHeight + 内边距而不是固定 height：系统字体放大（textScale 2.0）
+      // 时固定高度会把标题裁掉，minHeight 能自然长高。
+      constraints: BoxConstraints(minHeight: tv ? 52 : 40),
+      padding: EdgeInsets.symmetric(
+        horizontal: tv ? 14 : 10,
+        vertical: tv ? 6 : 4,
+      ),
+      decoration: BoxDecoration(
+        color: colors.surfaceContainerHighest.withValues(alpha: tv ? .62 : .78),
+        borderRadius: BorderRadius.circular(tv ? 14 : 12),
+        border: Border.all(
+          color: colors.outlineVariant.withValues(alpha: .55),
+          width: 1,
+        ),
+      ),
+      child: Row(
+        mainAxisSize: MainAxisSize.min,
+        children: [
+          Icon(
+            icon ?? (tv ? Icons.live_tv_rounded : Icons.dns_rounded),
+            size: tv ? 22 : 17,
+            color: enabled ? colors.primary : colors.onSurfaceVariant,
+          ),
+          SizedBox(width: tv ? 10 : 7),
+          Flexible(
+            child: Text(
+              label,
+              maxLines: 1,
+              overflow: TextOverflow.ellipsis,
+              style: TextStyle(
+                fontSize: tv ? 20 : 16,
+                fontWeight: FontWeight.w800,
+              ),
+            ),
+          ),
+          // 多站源时给出数量，避免「黄果」被误认为只有一个入口。
+          if (tv && count > 1) ...[
+            const SizedBox(width: 8),
+            Container(
+              padding: const EdgeInsets.symmetric(horizontal: 7, vertical: 2),
+              decoration: BoxDecoration(
+                color: colors.primary.withValues(alpha: .16),
+                borderRadius: BorderRadius.circular(8),
+              ),
+              child: Text(
+                '$count 源',
+                style: TextStyle(
+                  fontSize: 13,
+                  fontWeight: FontWeight.w700,
+                  color: colors.primary,
+                ),
+              ),
+            ),
+          ],
+          if (enabled) ...[
+            const SizedBox(width: 2),
+            Icon(
+              Icons.expand_more_rounded,
+              size: tv ? 26 : 20,
+              color: colors.onSurfaceVariant,
+            ),
+          ],
+        ],
+      ),
+    );
+    if (tv) {
+      return RemoteTarget(
+        onPressed: onPressed,
+        label: '站源：$label${enabled ? '，按确定切换' : '，当前不可用'}',
+        child: pill,
+      );
+    }
+    return InkWell(
+      borderRadius: BorderRadius.circular(12),
+      onTap: onPressed,
+      child: pill,
+    );
+  }
+}
+
