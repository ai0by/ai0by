+              color: colors.onPrimary,
+            )
+          : null,
     );
   }
-}
\ No newline at end of file
+
+  /// 全选 / 清空：TV 上同样要能聚焦，所以 TV 用 RemoteTarget，
+  /// 手机沿用 TextButton（触屏不需要焦点环，也省一点宽度）。
+  Widget _quickAction({
+    required Key key,
+    required String label,
+    required VoidCallback onPressed,
+  }) {
+    final tv = _tv;
+    if (!tv) {
+      return TextButton(key: key, onPressed: onPressed, child: Text(label));
+    }
+    final colors = Theme.of(context).colorScheme;
+    return RemoteTarget(
+      key: key,
+      onPressed: onPressed,
+      label: label,
+      child: Padding(
+        padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
+        child: Text(
+          label,
+          style: TextStyle(
+            fontSize: 16,
+            fontWeight: FontWeight.w700,
+            color: colors.primary,
+          ),
+        ),
+      ),
+    );
+  }
+
+  Widget _sheetButton({
+    required Key key,
+    required String label,
+    required bool tv,
+    required VoidCallback onPressed,
+    bool filled = false,
+  }) {
+    if (!tv) {
+      final child = Text(label);
+      return filled
+          ? FilledButton(key: key, onPressed: onPressed, child: child)
+          : OutlinedButton(key: key, onPressed: onPressed, child: child);
+    }
+    final colors = Theme.of(context).colorScheme;
+    return RemoteTarget(
+      key: key,
+      onPressed: onPressed,
+      label: label,
+      child: Container(
+        height: 52,
+        alignment: Alignment.center,
+        decoration: BoxDecoration(
+          color: filled ? colors.primary : colors.surfaceContainerHighest,
+          borderRadius: BorderRadius.circular(12),
+          border: filled
+              ? null
+              : Border.all(color: colors.outlineVariant, width: 1),
+        ),
+        child: Text(
+          label,
+          style: TextStyle(
+            fontSize: 18,
+            fontWeight: FontWeight.w700,
+            color: filled ? colors.onPrimary : colors.onSurface,
+          ),
+        ),
+      ),
+    );
+  }
+}
